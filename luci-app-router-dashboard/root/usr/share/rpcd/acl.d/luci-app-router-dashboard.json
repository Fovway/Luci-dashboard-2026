{
  "luci-app-router-dashboard": {
    "description": "Allow access to Router Dashboard status and service controls",
    "read": {
      "ubus": {
        "system": [ "board", "info" ],
        "network.interface": [ "dump" ],
        "network.wireless": [ "status" ],
        "iwinfo": [ "info", "assoclist" ],
        "luci-rpc": [ "getHostHints", "getNetworkDevices" ],
        "rc": [ "list", "init" ]
      },
      "file": {
        "/sys/class/thermal/thermal_zone0/temp": [ "read" ],
        "/proc/cpuinfo": [ "read" ],
        "/etc/init.d/adguardhome": [ "read" ],
        "/etc/init.d/forkop": [ "read" ],
        "/etc/init.d/sing-box": [ "read" ]
      }
    },
    "write": {
      "ubus": {
        "rc": [ "init" ]
      }
    }
  }
}
